{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.WYRE-AI/openframe-mcp",
  "title": "OpenFrame",
  "description": "MCP server for the OpenFrame External API.",
  "repository": {
      "url": "https://github.com/WYRE-AI/openframe-mcp",
    "source": "github"
  },
  "version": "0.0.0",
  "websiteUrl": "https://github.com/WYRE-AI/openframe-mcp",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/wyre-ai/openframe-mcp:0.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "OPENFRAME_API_KEY",
          "description": "OpenFrame API key",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
